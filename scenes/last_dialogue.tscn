[sub_resource type="GDScript" id="GDScript_qwhmd"]
script/source = "extends CanvasLayer

@onready var dialogue_box: PanelContainer = $DialogueBox
@onready var label: Label = $DialogueBox/Label
@onready var blip_sound: AudioStreamPlayer = $AudioStreamPlayer
@onready var gunshot_sound: AudioStreamPlayer = $GunshotSound # Optional: add your gunshot wav here

var witch_lines: Array[String] = [
	\"Hah! You abandoned your blade for that hunk of iron, knight?\",
	\"The sun is setting—it is a part of you now!\",
	\"You may have stripped me of my honor, witch...\",
	\"But I learned how to pull the trigger.\"
]

var current_line: int = 0
var is_typing: bool = false
var dialogue_active: bool = false
var has_triggered: bool = false

func _ready() -> void:
	dialogue_box.visible = false

# Connected from WizardTrigger's body_entered signal
func _on_wizard_trigger_body_entered(body: Node2D) -> void:
	# Make sure it's the player (check your player node's name or group)
	if body.name == \"Player\" or body.is_in_group(\"player\"):
		if not has_triggered:
			has_triggered = true
			start_dialogue(body)

func start_dialogue(player: Node2D) -> void:
	dialogue_active = true
	dialogue_box.visible = true
	
	# Freeze player movement during cutscene (optional)
	player.set_physics_process(false)
	
	current_line = 0
	show_line(current_line)

func _unhandled_input(event: InputEvent) -> void:
	if not dialogue_active:
		return
		
	if event.is_action_pressed(\"ui_accept\") or (event is InputEventMouseButton and event.pressed):
		if is_typing:
			label.visible_characters = label.text.length()
			is_typing = false
		else:
			current_line += 1
			if current_line < witch_lines.size():
				show_line(current_line)
			else:
				end_game_sequence()

func show_line(index: int) -> void:
	is_typing = true
	label.text = witch_lines[index]
	label.visible_characters = 0
	
	for i in range(label.text.length()):
		if not is_typing:
			break
		label.visible_characters += 1
		if label.text[i] != \" \":
			blip_sound.play()
		await get_tree().create_timer(0.05).timeout
		
	is_typing = false

func end_game_sequence() -> void:
	dialogue_active = false
	dialogue_box.visible = false
	
	# Play the gunshot sound, wait 1.5 seconds, then end/return to main menu
	if gunshot_sound:
		gunshot_sound.play()
	await get_tree().create_timer(1.5).timeout
	get_tree().change_scene_to_file(\"res://scenes/Main_Menu.tscn\")
"

